{
  "name": "tickforge",
  "version": "0.1.0",
  "private": true,
  "description": "Authoritative real-time multiplayer game server engine: prediction, rollback, lag compensation, matchmaking and room scaling.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 \"packages/*/test/**/*.test.ts\"",
    "server": "node packages/demo/src/serve.ts",
    "bots": "node packages/demo/src/bots.ts",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "typescript": "5.9.3"
  }
}
